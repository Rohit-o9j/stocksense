# Neon Postgres connection string.
# Copy this file to .env and paste the pooled connection string from the Neon
# console (Dashboard -> Connect). Keep the sslmode parameter.
#
# Must NOT be prefixed with VITE_ — that would inject the credential into the
# client bundle and expose it to anyone who opens devtools.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Signs and encrypts the session cookie. Must be at least 32 characters.
# Generate one with:  bun -e "console.log(crypto.randomUUID().replace(/-/g,'')+crypto.randomUUID().replace(/-/g,''))"
SESSION_SECRET=""
